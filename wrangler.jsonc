{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Name des Workers. Er MUSS exakt so heißen wie der Worker im
  // Cloudflare-Dashboard – sonst legt `wrangler deploy` einen zweiten,
  // leeren Worker an und die Geheimnisse liegen am falschen Ort.
  // Aktuell: https://trainer-assistent-by-linzenich.<subdomain>.workers.dev
  "name": "trainer-assistent-by-linzenich",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Die komplette App liegt in public/ und wird von Cloudflare als
  // statische Datei ausgeliefert – aber erst, nachdem der Worker die
  // Anmeldung geprüft hat ("run_worker_first": true).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },

  // WICHTIG: Ohne diese Zeile ist diese Datei die alleinige Wahrheit für alle
  // Klartext-Variablen. Wrangler löscht dann bei JEDEM Deploy alles, was im
  // Dashboard eingetragen wurde und hier nicht steht.
  //
  // Praktische Folge: Wer im Dashboard ein Passwort anlegt und dabei den
  // voreingestellten Typ "Text" stehen lässt, verliert es beim nächsten Build
  // wieder – scheinbar grundlos. Mit "keep_vars" bleiben solche Einträge
  // erhalten. Echte Secrets sind ohnehin ausgenommen.
  "keep_vars": true,

  // Nicht geheime Einstellungen. Geheimnisse (APP_PASSWORD, SESSION_SECRET)
  // gehören NICHT hierher, sondern in den Secret-Store.
  "vars": {
    // Wie lange bleibt ein Mitarbeiter angemeldet (Stunden). 720 = 30 Tage.
    "SESSION_TTL_HOURS": "720",
    // Vorauswahl für die Gültigkeit eines QR-Codes (Stunden).
    "SHARE_DEFAULT_TTL_HOURS": "72",
    // Obergrenze, die im QR-Dialog gewählt werden kann (Stunden). 720 = 30 Tage.
    "SHARE_MAX_TTL_HOURS": "720"
  },

  // Befristete Ablage für PDFs, die ein Modul im Browser erzeugt (Trainingsplan,
  // FMS-Bericht, PWC-Auswertung, Food-Swap-Plan). Ohne sie bleibt der Knopf
  // "QR-Code" in den Modulen wirkungslos – Herunterladen und Ausdrucken gehen
  // weiterhin. Einmalig einrichten (Anleitung Abschnitt 5.2):
  //
  //   npx wrangler kv namespace create SHARE_STORE
  //
  // Der Befehl gibt eine id aus. Diese unten eintragen und die vier Zeilen
  // entkommentieren – erst dann funktioniert der QR-Knopf.
  //
  // "kv_namespaces": [
  //   { "binding": "SHARE_STORE", "id": "HIER_DIE_AUSGEGEBENE_ID_EINTRAGEN" }
  // ],

  // Bremst Passwort-Rateversuche aus: max. 8 Login-Versuche pro Minute und IP.
  // namespace_id ist eine frei wählbare Zahl, die im Account eindeutig sein muss.
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
